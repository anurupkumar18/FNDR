# Dependencies
node_modules/
target/
src-tauri/target/
dist/
.venv/
__pycache__/
*.pyc
.eval-tmp/

# AI Models (large binaries)
*.gguf
src-tauri/models/*.gguf

# User Data & Storage (CRITICAL: MUST NOT BE COMMITTED)
*.json
# Project config must stay visible to tools that honor .gitignore
# (tauri-action searches for tauri.conf.json this way and failed without it).
!package.json
!package-lock.json
!tsconfig*.json
!src-tauri/tauri.conf.json
*.json.migrated
!src-tauri/capabilities/
!src-tauri/capabilities/*.json
!src-tauri/tests/fixtures/
!src-tauri/tests/fixtures/**/*.json
!docs/team/
!docs/team/*.json
*.lancedb/
*.db/
*.lance/
/data/
meetings/
*.wav
*.mp3
*.webm
*.transcript.md

# Environment & Config
.env
.env.*
!.env.example

# OS / IDE
.DS_Store
.vscode/
.idea/
*.log

# Migration artifacts
*.migrated

# Swift Package Manager build artifacts
.build/
apps/ios/FNDRKit/.build/

# Build output
build/

# iOS / Xcode
apps/ios/Local.xcconfig
apps/ios/DerivedData/
apps/ios/build/
apps/ios/*.xcresult
apps/ios/**/*.xcresult
apps/ios/.swiftpm/
DerivedData/
xcuserdata/
*.xcuserstate
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/

# Fastlane (pre-emptive)
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/

# Claude Code worktrees (never commit)
.claude/worktrees/

# Local browser-audit artifacts
.playwright-cli/
